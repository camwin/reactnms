# ReactNMS environment example
# Copy to .env and fill in. Do not commit .env.

# Backend
PORT=3001
DATA_DIR=/app/data

# Default SNMP target (used by /api/device when no host query param)
SNMP_HOST=192.168.1.1
SNMP_COMMUNITY=public

# Frontend (build-time). Leave unset to call same-origin /api.
# nginx proxies /api to the backend, and `npm run dev` proxies /api to :3001.
# Set this only when the API is on another origin.
# VITE_API_URL=http://localhost:3001
